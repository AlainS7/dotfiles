# =============================================================================
#   LOCAL MACHINE CONFIGURATION (TEMPLATE)
# =============================================================================
#
# This file is a template for machine-specific settings that should not be
# committed to the dotfiles repository (e.g., paths, secrets).
#
# The install script will copy this file to ~/.zshrc.local if it doesn't
# exist. You can then edit ~/.zshrc.local to fit the current machine.
#
# =============================================================================

# --- 1Password SSH Agent ---
# On macOS, the 1Password desktop app provides an SSH agent.
# Uncomment and adjust if you use 1Password for SSH keys.
# if [ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]; then
#   export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
# fi

# --- 1Password Secret References ---
# Configure paths for the load_1password_secrets function.
# export OP_LITELLM_SECRET_PATH='op://My Vault/LiteLLM/LITELLM_TOKEN'

# --- NVM (Node Version Manager) ---
# Uncomment if you use NVM for managing Node.js versions.
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
# [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- Google Cloud SDK ---
# The path to your Google Cloud SDK installation may be machine-specific.
# Uncomment and update the path here if needed.
# if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
# if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# --- Homebrew Packages ---
# Add paths for specific Homebrew packages. The path can differ between
# Intel Macs (/usr/local/opt) and Apple Silicon Macs (/opt/homebrew/opt).
# export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
